# =========================================================================
# Supabase & Application Configuration for Nuwan.dev Portfolio Website
# =========================================================================
# Duplicate this file as .env or .env.local and populate with your own
# credentials.
#
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# =========================================================================

# 1. Supabase Project URL & Anonymous Key (safe for frontend clients)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here

# Optional Fallbacks (Next.js/Vercel standard prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# 2. Server-side Supabase Service Role Key (Optional, for backend audit logs)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 3. Real Email Delivery to Gmail Configuration (api/contact.js)
# Step 1: Set your Gmail address
GMAIL_USER=nuwandevinda2002@gmail.com

# Step 2: Generate a 16-character App Password from Google:
#   Google Account -> Security -> 2-Step Verification -> App Passwords
#   Select "Mail" and "Portfolio Website"
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Step 3: Destination Receiving Email (defaults to GMAIL_USER if omitted)
CONTACT_RECEIVING_EMAIL=nuwandevinda2002@gmail.com

# 4. Optional Alternative: Resend API Key
# RESEND_API_KEY=re_123456789
