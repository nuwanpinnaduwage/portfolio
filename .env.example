# =========================================================================
# Supabase Configuration for Nuwan.dev Portfolio Website
# =========================================================================
# Duplicate this file as .env or .env.local and populate with your own
# Supabase project credentials (found in Supabase Dashboard -> Project Settings -> API).
#
# DO NOT COMMIT REAL SECRETS OR SERVICE_ROLE KEYS TO SOURCE CONTROL.
# =========================================================================

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Publishable API Key (safe for public frontend clients)
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here

# Optional Fallbacks (compatible with Next.js/Vercel standard prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here
