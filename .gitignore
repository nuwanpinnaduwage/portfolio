# Dependencies
node_modules/
.pnp
.pnp.js

# Production Build Output
dist/
dist-ssr/
build/
out/

# Environment Variables & Sensitive Credentials (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
databasepw/
*password*.txt
*secret*.txt
*credential*.txt

# Temporary Scratch Scripts & Inspection Logs
scratch/
coverage/
*.lcov
.nyc_output

# Runtime Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel Deployment Cache
.vercel

# Operating System & Editor Files
.DS_Store
.AppleDouble
.LSOverride
Icon?
Thumbs.db
ehthumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
